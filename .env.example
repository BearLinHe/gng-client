# Source database. The app only reads from this database during sync.
DATABASE_URL="postgresql://SOURCE_USER:SOURCE_PASSWORD@SOURCE_HOST/SOURCE_DB?sslmode=require"

# System database. The app reads and writes only this database at runtime.
SYSTEM_DATABASE_URL="postgresql://SYSTEM_USER:SYSTEM_PASSWORD@SYSTEM_HOST/SYSTEM_DB?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-secret"
